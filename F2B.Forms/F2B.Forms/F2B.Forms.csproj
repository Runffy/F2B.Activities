<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>F2B.Forms</RootNamespace>
    <AssemblyName>F2B.Forms</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Activities" />
    <Reference Include="System.Activities.Presentation" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <!-- Link helper into this assembly so OpenRPA only needs F2B.Forms.dll (no extra OpenRpa.Design.dll). -->
  <ItemGroup>
    <Compile Include="..\..\F2B.OpenRpa.Design\ActivityDesignerCollapseHelper.cs" Link="OpenRpa.Design\ActivityDesignerCollapseHelper.cs" />
  </ItemGroup>
</Project>
